	column Atrasado
		dataType: boolean
		lineageTag: f2069ff9-7d71-560e-a8d9-67f2764b9677
		summarizeBy: none
		sourceColumn: is_delayed

		annotation SummarizationSetBy = User

	column 'Faixa de atraso' = ```
		VAR d = Pedidos[Dias de atraso]
		RETURN
		    SWITCH (
		        TRUE (),
		        ISBLANK ( d ), "Não entregue",
		        d <= 0, "No prazo",
		        d >= 11, "11+ dias",
		        d = 1, "1 dia",
		        FORMAT ( d, "0" ) & " dias"
		    )
		```
		dataType: string
		lineageTag: c181b9d7-989b-5fef-9192-1f1882279f5b
		summarizeBy: none
		sortByColumn: 'Faixa ordem'

		annotation SummarizationSetBy = User

	column 'Faixa ordem' = ```
		VAR d = Pedidos[Dias de atraso]
		RETURN SWITCH ( TRUE (), ISBLANK ( d ), 99, d <= 0, 0, d >= 11, 11, d )
		```
		dataType: int64
		formatString: 0
		lineageTag: 766fd740-fc2e-5b1a-8ae2-26ea4e6ce24c
		summarizeBy: none
		isHidden

		annotation SummarizationSetBy = User

	partition Pedidos = m
		mode: import
		source =
				let
				    Arquivo = if Text.StartsWith ( DataFolder, "http" )
				        then Web.Contents ( DataFolder & "/fct_orders.parquet" )
				        else File.Contents ( DataFolder & "\fct_orders.parquet" ),
				    Fonte = Parquet.Document ( Arquivo ),
				    Tipos = Table.TransformColumnTypes ( Fonte, {{"order_id", type text}, {"customer_id", type text}, {"status", type text}, {"purchase_date", type date}, {"total_payment_value", Currency.Type}, {"max_installments", Int64.Type}, {"item_count", Int64.Type}, {"total_item_price", Currency.Type}, {"total_freight", Currency.Type}, {"review_score", Int64.Type}, {"delivery_days", Int64.Type}, {"delay_days", Int64.Type}, {"is_delayed", type logical}} )
				in
				    Tipos

	annotation PBI_ResultType = Table
