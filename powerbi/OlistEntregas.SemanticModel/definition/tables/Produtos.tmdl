	column Categoria = ```
		IF (
		    ISBLANK ( Produtos[Categoria original] ) || Produtos[Categoria original] = "",
		    "sem categoria",
		    SUBSTITUTE ( Produtos[Categoria original], "_", " " )
		)
		```
		dataType: string
		lineageTag: 5a834141-eeeb-54b3-9a1b-e789a2979a04
		summarizeBy: none

		annotation SummarizationSetBy = User

	partition Produtos = m
		mode: import
		source =
				let
				    Arquivo = if Text.StartsWith ( DataFolder, "http" )
				        then Binary.Buffer ( Web.Contents ( DataFolder & "/dim_products.parquet" ) )
				        else File.Contents ( DataFolder & "\dim_products.parquet" ),
				    Fonte = Parquet.Document ( Arquivo ),
				    Tipos = Table.TransformColumnTypes ( Fonte, {{"product_id", type text}, {"product_category_name", type text}, {"category_name_english", type text}, {"product_weight_g", Int64.Type}, {"product_length_cm", Int64.Type}, {"product_height_cm", Int64.Type}, {"product_width_cm", Int64.Type}, {"product_photos_qty", Int64.Type}} )
				in
				    Tipos

	annotation PBI_ResultType = Table
